{
  "version": 3,
  "product": "ALVA CRM",
  "canonical": {
    "landing": {
      "path": "/",
      "entry": "index.html"
    },
    "demo": {
      "path": "/demo/",
      "entry": "demo/index.html",
      "dataPolicy": "synthetic-only"
    },
    "admin": {
      "path": "/admin/",
      "entry": "admin/index.html"
    },
    "app": {
      "path": "/app/",
      "entry": "app/index.html",
      "tenantAware": true,
      "tenantPattern": "/app/<tenant>/"
    },
    "collaborators": {
      "path": "/app/<tenant>/colaboradores/",
      "entry": "runtime/colaboradores.html",
      "tenantAware": true
    }
  },
  "legacy": {
    "commercial": "/platform/site/",
    "admin": "/platform/admin/",
    "crmRoot": "legacy main root before phase B",
    "collaborators": "/colaborador/"
  },
  "future": {},
  "aliases": {
    "cyaCrm": {
      "path": "/C&ACRM/",
      "tenant": "casillas-asociados",
      "surface": "crm"
    },
    "cyaCollaborators": {
      "path": "/C&ACRM/Colaboradores/",
      "tenant": "casillas-asociados",
      "surface": "collaborators"
    }
  },
  "compatibility": {
    "queryTenant": "redirect-to-canonical",
    "collaboratorLegacy": "/colaborador/ -> /C&ACRM/Colaboradores/",
    "platformSite": "/platform/site/ -> /",
    "platformAdmin": "/platform/admin/ -> /admin/",
    "githubPages": {
      "origin": "https://jeanmaxx.github.io/CyA_CRM/",
      "bridge": "github-pages-bridge.js",
      "fallback": "404.html",
      "defaultOperationalTarget": "https://crm-alvasd.pages.dev/C&ACRM/"
    }
  },
  "cloudflare": {
    "router": "_worker.js",
    "fallbackRules": "_redirects"
  }
}
