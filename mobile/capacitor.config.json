{
  "appId": "com.alvasd.cya.crm",
  "appName": "C&A CRM",
  "webDir": "www",
  "server": {
    "url": "https://crm-alvasd.pages.dev/app/casillas-asociados/?native=android-v23&firebase=1",
    "cleartext": false,
    "allowNavigation": [
      "crm-alvasd.pages.dev"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "minWebViewVersion": 60
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "hidden": false
    },
    "PushNotifications": {
      "presentationOptions": ["alert", "sound", "badge"]
    }
  }
}
